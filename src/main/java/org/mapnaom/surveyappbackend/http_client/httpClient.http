@baseUrl = http://localhost:8083
@questionId = 1
@jwtToken =

### Login and save JWT token to env var
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "admin",
  "password": "admin"
}

> {%
  client.global.set("jwtToken", response.body.token || response.body.accessToken || response.body.jwt || "");
%}

### List all questions
GET {{baseUrl}}/api/questions
Authorization: Bearer {{jwtToken}}
Accept: application/json

### Get a question by id
GET {{baseUrl}}/api/questions/{{questionId}}
Authorization: Bearer {{jwtToken}}
Accept: application/json

### Create a new question
POST {{baseUrl}}/api/questions
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
Accept: application/json

{
  "surveyId": 1,
  "criterionId": 1,
  "code": "MOCK-Q001",
  "text": "How effectively does the organization lead change?",
  "role": "MANAGERS",
  "levels": [
    {
      "title": "Initial",
      "score": 1,
      "levelOrder": 1
    },
    {
      "title": "Developing",
      "score": 2,
      "levelOrder": 2
    },
    {
      "title": "Established",
      "score": 3,
      "levelOrder": 3
    },
    {
      "title": "Excellent",
      "score": 4,
      "levelOrder": 4
    }
  ]
}

### Update an existing question
PUT {{baseUrl}}/api/questions/{{questionId}}
Authorization: Bearer {{jwtToken}}
Content-Type: application/json
Accept: application/json

{
  "text": "What is your favorite programming language?",
  "type": "MULTIPLE_CHOICE",
  "required": true,
  "options": [
    "Java",
    "Python",
    "JavaScript",
    "C#"
  ]
}

### Delete a question
DELETE {{baseUrl}}/api/questions/{{questionId}}
Authorization: Bearer {{jwtToken}}
Accept: application/json
